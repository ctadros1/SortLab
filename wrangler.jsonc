{
  "$schema": "https://unpkg.com/wrangler@4.107.0/config-schema.json",
  "name": "sortlab-project-site",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "project.christiantadros.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/sortlab", "/sortlab/api/*"],
  },
  "vars": {
    "TURNSTILE_VERIFY_URL": "https://sortlab-turnstile-siteverify.home-server-b7f.workers.dev/siteverify",
    "REPORT_TO": "c@christiantadros.com",
    "REPORT_FROM": "SortLab <hello@christiantadros.com>",
  },
}
